---
import '../styles/global.css';
import InstallPrompt from '../components/pwa/InstallPrompt.tsx';

interface Props {
	title?: string;
	description?: string;
	keywords?: string;
	canonicalURL?: string;
	ogImage?: string;
	ogType?: string;
	faqSchema?: any;
}

const {
	title = "AI NoteBook - Smart AI Notebook App, Online Note & Todo Note Platform",
	description = "AI NoteBook is the ultimate online note taking and todo note application for students and professionals. Organize study materials with our smart study material uploader, instant search, and markdown editor.",
	keywords = "AI NoteBook, ai notebook app, online note, todo note, study material uploader, markdown study notes, note taking app",
	canonicalURL = Astro.url.href,
	ogImage = "/og-image.png",
	ogType = "website",
	faqSchema = null
} = Astro.props;

const siteUrl = Astro.site ? Astro.site.toString() : "https://notebook.app";
const fullOgImageUrl = new URL(ogImage, siteUrl).toString();

const jsonLd = {
	"@context": "https://schema.org",
	"@type": "SoftwareApplication",
	"name": "AI Study Notebook",
	"applicationCategory": "EducationalApplication",
	"operatingSystem": "Web",
	"offers": {
		"@type": "Offer",
		"price": "0",
		"priceCurrency": "USD"
	},
	"description": description,
	"keywords": keywords,
	"url": canonicalURL
};
---
<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		
		<!-- PWA Primary & Mobile Meta Tags -->
		<meta name="theme-color" content="#171717" />
		<meta name="mobile-web-app-capable" content="yes" />
		<meta name="apple-mobile-web-app-capable" content="yes" />
		<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
		<meta name="apple-mobile-web-app-title" content="Notebook AI" />

		<!-- Icons & Web App Manifest -->
		<link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="shortcut icon" href="/favicon.ico" />
		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
		<link rel="manifest" href="/site.webmanifest" />
		<meta name="generator" content={Astro.generator} />
		
		<!-- Primary Meta Tags -->
		<title>{title}</title>
		<meta name="title" content={title} />
		<meta name="description" content={description} />
		<meta name="keywords" content={keywords} />
		<meta name="author" content="AI Study Notebook" />
		<meta name="robots" content="index, follow" />
		<link rel="canonical" href={canonicalURL} />

		<!-- Open Graph / Facebook / LinkedIn / WhatsApp -->
		<meta property="og:site_name" content="AI Study Notebook" />
		<meta property="og:type" content={ogType} />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={fullOgImageUrl} />
		<meta property="og:image:alt" content="AI Study Notebook - Smart AI Notebook App, Online Note & Study Material Uploader" />
		<meta property="og:locale" content="en_US" />

		<!-- Twitter Meta Tags -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:url" content={canonicalURL} />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={fullOgImageUrl} />

		<!-- Preconnect to Google Fonts -->
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<!-- Load Inter for UI/Headings and JetBrains Mono for Code/Captions -->
		<link href="https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&family=JetBrains+Mono:ital,wght@0,100..800;1,100..800&display=swap" rel="stylesheet" />

		<!-- Schema.org Structured Data -->
		<script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
		{faqSchema && (
			<script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />
		)}

		<!-- Inline script to determine and set user theme instantly -->
		<script is:inline>
			(() => {
				const theme = (() => {
					if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
						return localStorage.getItem('theme');
					}
					if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
						return 'dark';
					}
					return 'light';
				})();
				
				if (theme === 'dark') {
					document.documentElement.classList.add('dark');
				} else {
					document.documentElement.classList.remove('dark');
				}
				window.localStorage.setItem('theme', theme);
			})();
		</script>

		<!-- Service Worker Registration -->
		<script is:inline>
			if ('serviceWorker' in navigator) {
				window.addEventListener('load', () => {
					navigator.serviceWorker.register('/sw.js')
						.then((reg) => {
							console.log('[PWA] ServiceWorker registered with scope:', reg.scope);
						})
						.catch((err) => {
							console.error('[PWA] ServiceWorker registration failed:', err);
						});
				});
			}
		</script>
	</head>
	<body>
		<slot />
		<InstallPrompt client:only="react" variant="banner" />
	</body>
</html>
