---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout 
	title="Offline - AI Study Notebook" 
	description="You are currently offline. Previously opened notes remain accessible."
>
	<Header currentPath="/offline" />

	<main class="relative min-h-[calc(100vh-4rem-12rem)] flex items-center justify-center py-16 px-4">
		<!-- Mesh gradient background -->
		<div class="mesh-gradient-container"></div>

		<div class="relative z-10 max-w-md w-full bg-canvas border border-hairline rounded-lg p-8 shadow-level-3 text-center">
			<!-- Wifi Off Icon -->
			<div class="w-16 h-16 mx-auto mb-6 bg-canvas-soft-2 text-ink border border-hairline rounded-full flex items-center justify-center">
				<svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-wifi-off">
					<line x1="2" x2="22" y1="2" y2="22"/>
					<path d="M8.5 16.5a5 5 0 0 1 7 0"/>
					<path d="M2 8.82a15 15 0 0 1 4.17-2.65"/>
					<path d="M10.66 5c4.01-.36 8.14.9 11.34 3.82"/>
					<path d="M16.85 11.25a10 10 0 0 1 2.22 1.68"/>
					<path d="M5 13a10 10 0 0 1 5.24-2.67"/>
					<line x1="12" x2="12.01" y1="20" y2="20"/>
				</svg>
			</div>

			<h1 class="text-2xl font-bold font-sans tracking-tight text-ink mb-2">
				You are offline
			</h1>
			
			<p class="text-sm font-sans text-body mb-6 leading-relaxed">
				It looks like you've lost your internet connection. Don't worry — any notes you previously opened or edited are safely saved locally on your device.
			</p>

			<div class="bg-canvas-soft border border-hairline rounded-md p-4 mb-6 text-left">
				<h2 class="text-xs font-semibold font-mono uppercase tracking-wider text-ink mb-2">
					Available Offline:
				</h2>
				<ul class="text-xs text-body space-y-1.5 list-disc pl-4 font-sans">
					<li>Viewing previously opened notes & study files</li>
					<li>Editing existing offline notes</li>
					<li>Creating new local draft notes</li>
				</ul>
			</div>

			<div class="flex flex-col sm:flex-row gap-3 justify-center">
				<button 
					onclick="window.location.reload()" 
					class="w-full sm:w-auto px-5 py-2.5 bg-primary text-on-primary font-semibold text-xs rounded-full shadow-level-2 hover:opacity-90 transition-opacity cursor-pointer flex items-center justify-center gap-2"
				>
					<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
						<path d="M21 12a9 9 0 0 0-9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/>
						<path d="M3 3v5h5"/>
						<path d="M3 12a9 9 0 0 0 9 9 9.75 9.75 0 0 0 6.74-2.74L21 16"/>
						<path d="M16 16h5v5"/>
					</svg>
					Retry Connection
				</button>
				<a 
					href="/dashboard" 
					class="w-full sm:w-auto px-5 py-2.5 bg-canvas border border-hairline text-ink font-semibold text-xs rounded-full hover:bg-canvas-soft-2 transition-colors flex items-center justify-center"
				>
					Go to Dashboard
				</a>
			</div>
		</div>
	</main>

	<Footer />
</Layout>
