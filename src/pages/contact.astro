---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ContactForm from '../components/ContactForm';
import { Mail, MessageSquare, HelpCircle, Clock, MapPin, Sparkles } from 'lucide-react';
---

<Layout 
	title="Contact Us - AI NoteBook"
	description="Contact the AI NoteBook support and development team. We are here to help with your online notes, study material uploads, and platform inquiries."
	keywords="Contact AI NoteBook, ai notebook support, help desk online note app, contact support team"
	canonicalURL="https://notebook.app/contact"
>
	<Header currentPath="/contact" />

	<main class="relative min-h-screen bg-canvas-soft">
		<!-- Mesh Gradient Background -->
		<div class="mesh-gradient-container opacity-20"></div>

		<!-- Page Header -->
		<section class="relative max-w-[1100px] mx-auto px-6 pt-16 pb-12 z-10">
			<div class="inline-flex items-center gap-2 px-3 py-1 bg-link-bg-soft/50 border border-[#d3e5ff]/40 text-link-deep text-[11px] font-mono rounded-full mb-4">
				<Mail size={12} className="text-link" />
				<span>GET IN TOUCH</span>
			</div>
			
			<h1 class="text-3xl sm:text-5xl font-semibold text-ink tracking-tight mb-4">
				Contact Our Team.
			</h1>
			
			<p class="text-sm sm:text-base text-body max-w-2xl leading-relaxed">
				Have questions about AI NoteBook, need technical assistance, or want to suggest a new feature? We'd love to hear from you.
			</p>
		</section>

		<!-- Main Section Grid -->
		<section class="relative max-w-[1100px] mx-auto px-6 pb-24 z-10">
			<div class="grid grid-cols-1 lg:grid-cols-3 gap-8 items-start">
				
				<!-- Direct Contact Info Cards (1 col) -->
				<div class="space-y-4 lg:col-span-1">
					
					<!-- Card 1: Email -->
					<div class="bg-canvas border border-hairline rounded-xl p-5 shadow-level-1 space-y-2">
						<div class="flex items-center gap-3 text-ink">
							<div class="w-8 h-8 rounded-lg bg-canvas-soft border border-hairline flex items-center justify-center">
								<Mail size={16} className="text-link" />
							</div>
							<h3 class="font-semibold text-sm">Direct Support Email</h3>
						</div>
						<p class="text-xs text-mute leading-relaxed">
							Email us anytime for account inquiries or support.
						</p>
						<a href="mailto:support@notebook.app" class="inline-block text-xs font-mono font-medium text-link hover:underline">
							support@notebook.app
						</a>
					</div>

					<!-- Card 2: Community -->
					<div class="bg-canvas border border-hairline rounded-xl p-5 shadow-level-1 space-y-2">
						<div class="flex items-center gap-3 text-ink">
							<div class="w-8 h-8 rounded-lg bg-canvas-soft border border-hairline flex items-center justify-center">
								<MessageSquare size={16} className="text-violet-600" />
							</div>
							<h3 class="font-semibold text-sm">Community & Discord</h3>
						</div>
						<p class="text-xs text-mute leading-relaxed">
							Join our Discord server to chat with students and devs.
						</p>
						<a href="https://discord.com" target="_blank" rel="noopener noreferrer" class="inline-block text-xs font-mono font-medium text-link hover:underline">
							discord.gg/notebook
						</a>
					</div>

					<!-- Card 3: Hours & SLA -->
					<div class="bg-canvas border border-hairline rounded-xl p-5 shadow-level-1 space-y-2 text-xs">
						<div class="flex items-center gap-3 text-ink mb-1">
							<div class="w-8 h-8 rounded-lg bg-canvas-soft border border-hairline flex items-center justify-center">
								<Clock size={16} className="text-emerald-500" />
							</div>
							<h3 class="font-semibold text-sm">Support Availability</h3>
						</div>
						<div class="space-y-1 text-mute">
							<div class="flex justify-between">
								<span>Mon - Fri:</span>
								<span class="text-ink font-mono">9:00 AM - 6:00 PM UTC</span>
							</div>
							<div class="flex justify-between">
								<span>Response Time:</span>
								<span class="text-ink font-mono">&lt; 24 Hours</span>
							</div>
						</div>
					</div>

				</div>

				<!-- Form Container (2 cols) -->
				<div class="lg:col-span-2">
					<ContactForm client:only="react" />
				</div>

			</div>
		</section>

		<!-- Frequently Asked Help Section -->
		<section class="border-t border-hairline bg-canvas py-16 z-10 relative">
			<div class="max-w-[1100px] mx-auto px-6">
				<div class="text-center max-w-xl mx-auto space-y-3 mb-12">
					<span class="text-xs font-mono uppercase tracking-wider text-link font-semibold">Quick Answers</span>
					<h2 class="text-2xl sm:text-3xl font-semibold text-ink tracking-tight">
						Looking for quick help?
					</h2>
					<p class="text-xs sm:text-sm text-body">
						Check out these common support resources before submitting a request.
					</p>
				</div>

				<div class="grid grid-cols-1 sm:grid-cols-3 gap-6">
					<a href="/#faq" class="p-5 bg-canvas-soft border border-hairline rounded-xl shadow-level-1 space-y-2 hover:border-hairline-strong transition-colors group">
						<HelpCircle size={20} className="text-link group-hover:scale-110 transition-transform" />
						<h3 class="font-semibold text-sm text-ink">Read FAQ</h3>
						<p class="text-xs text-mute">Answers to top questions about notebook features, pricing, and storage.</p>
					</a>

					<a href="/privacy#security" class="p-5 bg-canvas-soft border border-hairline rounded-xl shadow-level-1 space-y-2 hover:border-hairline-strong transition-colors group">
						<Sparkles size={20} className="text-emerald-500 group-hover:scale-110 transition-transform" />
						<h3 class="font-semibold text-sm text-ink">Security & Encryption</h3>
						<p class="text-xs text-mute">Learn how we isolate database rows and encrypt study materials.</p>
					</a>

					<a href="/terms" class="p-5 bg-canvas-soft border border-hairline rounded-xl shadow-level-1 space-y-2 hover:border-hairline-strong transition-colors group">
						<MapPin size={20} className="text-violet-600 group-hover:scale-110 transition-transform" />
						<h3 class="font-semibold text-sm text-ink">Terms & Conditions</h3>
						<p class="text-xs text-mute">Understand user policies, acceptable use, and open markdown exports.</p>
					</a>
				</div>
			</div>
		</section>
	</main>

	<Footer />
</Layout>
