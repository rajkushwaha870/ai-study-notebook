---
import Layout from '../layouts/Layout.astro';
import SignupForm from '../components/auth/SignupForm';
---

<Layout 
	title="Create Account - AI NoteBook"
	description="Create your free AI NoteBook account today. Start organizing online notes, managing todo notes, and uploading study material effortlessly."
	keywords="AI NoteBook signup, register ai notebook app, free online note account"
>
  <main class="relative min-h-screen flex flex-col items-center justify-center p-6 bg-canvas-soft select-none">
    <!-- Atmospheric Background Mesh Gradient -->
    <div class="mesh-gradient-container opacity-10"></div>

    <div class="relative z-10 w-full max-w-md flex flex-col items-center">
      {/* Brand Header */}
      <a href="/" class="flex items-center gap-2 mb-8 group">
        <div class="w-6 h-6 bg-primary text-on-primary flex items-center justify-center rounded-sm text-xs font-bold font-mono group-hover:scale-105 transition-transform">
          N
        </div>
        <span class="text-sm font-semibold tracking-tight text-ink">NoteBook.</span>
      </a>

      {/* Auth Box */}
      <SignupForm client:only="react" />
    </div>
  </main>
</Layout>
